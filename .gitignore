# Server files (too large for git)
# Do NOT commit Hytale server archives, asset packs or stand-alone JARs.
# Distribute them via Releases / object storage and let the entrypoint
# download them on first run. Anything previously checked in was untracked
# with `git rm --cached` to keep the working tree but stop tracking.
*.jar
*.zip
*.aot

# Exception: Include bundled plugin JAR for manager
!manager/backend/assets/plugins/*.jar

# Local test data
data/
backups/
logs/
server/

# Environment (enthält evtl. URLs/Secrets)
.env
!.env.example

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Node.js / Manager
node_modules/
dist/
package-lock.json
manager/static/
